{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "shape",
        "dtype",
        "units"
      ],
      "properties": {
        "axes": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "dtype": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dataset": {
          "type": "string",
          "pattern": "^/"
        },
        "real_dataset": {
          "type": "string",
          "pattern": "^/"
        },
        "imag_dataset": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "oneOf": [
        {
          "required": [
            "dataset"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "real_dataset"
                ]
              },
              {
                "required": [
                  "imag_dataset"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "real_dataset",
            "imag_dataset"
          ],
          "not": {
            "required": [
              "dataset"
            ]
          }
        }
      ]
    }
  },
  "array_fields": {
    "frequencies_hz": {
      "axes": [
        "frequency"
      ],
      "units": "Hz",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "tx_xy_m": {
      "axes": [
        "tx,xy"
      ],
      "units": "m",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "rx_xy_m": {
      "axes": [
        "rx,xy"
      ],
      "units": "m",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "pressure": {
      "axes": [
        "frequency,tx,rx",
        "tx,rx,frequency"
      ],
      "units": "data_units",
      "dtypes": [
        "complex64",
        "complex128"
      ],
      "optional": false
    },
    "mask": {
      "axes": [
        "frequency,tx,rx",
        "tx,rx,frequency",
        "tx,rx"
      ],
      "units": "1",
      "dtypes": [
        "bool",
        "uint8"
      ],
      "optional": false
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "metadata",
    "arrays_file",
    "arrays"
  ],
  "properties": {
    "schema": {
      "const": "wust.frequency_input"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "metadata": {
      "type": "object"
    },
    "arrays_file": {
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequencies_hz",
        "tx_xy_m",
        "rx_xy_m",
        "pressure",
        "mask"
      ],
      "properties": {
        "frequencies_hz": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "frequency"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "Hz"
            }
          }
        },
        "tx_xy_m": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "tx,xy"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "m"
            }
          }
        },
        "rx_xy_m": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "rx,xy"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "m"
            }
          }
        },
        "pressure": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "frequency,tx,rx",
                "tx,rx,frequency"
              ]
            },
            "dtype": {
              "enum": [
                "complex64",
                "complex128"
              ]
            }
          }
        },
        "mask": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "frequency,tx,rx",
                "tx,rx,frequency",
                "tx,rx"
              ]
            },
            "dtype": {
              "enum": [
                "bool",
                "uint8"
              ]
            },
            "units": {
              "const": "1"
            }
          }
        }
      }
    }
  }
}
