{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "shape",
        "dtype",
        "units"
      ],
      "properties": {
        "axes": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "dtype": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dataset": {
          "type": "string",
          "pattern": "^/"
        },
        "real_dataset": {
          "type": "string",
          "pattern": "^/"
        },
        "imag_dataset": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "oneOf": [
        {
          "required": [
            "dataset"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "real_dataset"
                ]
              },
              {
                "required": [
                  "imag_dataset"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "real_dataset",
            "imag_dataset"
          ],
          "not": {
            "required": [
              "dataset"
            ]
          }
        }
      ]
    }
  },
  "array_fields": {
    "c_mps": {
      "axes": [
        "y,x"
      ],
      "units": "m/s",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "tx_xy_m": {
      "axes": [
        "tx,xy"
      ],
      "units": "m",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "rx_xy_m": {
      "axes": [
        "rx,xy"
      ],
      "units": "m",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    },
    "source_pressure": {
      "axes": [
        "time"
      ],
      "units": "Pa",
      "dtypes": [
        "float32",
        "float64"
      ],
      "optional": false
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "metadata",
    "arrays_file",
    "arrays"
  ],
  "properties": {
    "schema": {
      "const": "wust.simulation_input"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "metadata": {
      "type": "object"
    },
    "arrays_file": {
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c_mps",
        "tx_xy_m",
        "rx_xy_m",
        "source_pressure"
      ],
      "properties": {
        "c_mps": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "y,x"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "m/s"
            }
          }
        },
        "tx_xy_m": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "tx,xy"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "m"
            }
          }
        },
        "rx_xy_m": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "rx,xy"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "m"
            }
          }
        },
        "source_pressure": {
          "$ref": "#/$defs/array",
          "properties": {
            "axes": {
              "enum": [
                "time"
              ]
            },
            "dtype": {
              "enum": [
                "float32",
                "float64"
              ]
            },
            "units": {
              "const": "Pa"
            }
          }
        }
      }
    }
  }
}
