{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config",
    "input_manifest",
    "operation",
    "output_manifest",
    "schema",
    "schema_version"
  ],
  "properties": {
    "schema": {
      "const": "wust.request"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "operation": {
      "enum": [
        "ingest_frequency",
        "prepare",
        "reconstruct",
        "simulate"
      ]
    },
    "input_manifest": {
      "type": "string"
    },
    "output_manifest": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "initial_manifest": {
      "type": "string"
    },
    "frequency_schedule_hz": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "max_updates": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "save_history": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reconstruct"
          }
        }
      },
      "then": {
        "required": [
          "initial_manifest"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "frequency_schedule_hz"
              ]
            },
            {
              "required": [
                "initial_manifest"
              ]
            },
            {
              "required": [
                "max_updates"
              ]
            },
            {
              "required": [
                "save_history"
              ]
            }
          ]
        }
      }
    }
  ],
  "x-input-schemas": {
    "ingest_frequency": [
      "wust.frequency_input"
    ],
    "prepare": [
      "wust.rf"
    ],
    "reconstruct": [
      "wust.frequency_input",
      "wust.measurements"
    ],
    "simulate": [
      "wust.simulation_input"
    ]
  }
}
